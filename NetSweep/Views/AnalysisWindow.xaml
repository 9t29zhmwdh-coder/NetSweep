<Window x:Class="NetSweep.Views.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSweep - Analyse"
        Height="680" Width="1040"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="#F7F7F7" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Scannen" Command="{Binding ScanCommand}" FontWeight="SemiBold"/>
                <Button Content="Abbrechen" Command="{Binding CancelCommand}"/>
                <Separator Width="10" Background="Transparent"/>
                <Button Content="Duplikate suchen" Command="{Binding FindDuplicatesCommand}"/>
                <Button Content="Leere Ordner zeigen" Command="{Binding ShowEmptyFoldersCommand}"/>
                <Button Content="Leere Ordner löschen" Command="{Binding DeleteEmptyFoldersCommand}"/>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="8,6" Margin="0,8,0,0" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" Foreground="#888"
                           MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Status}" Foreground="#444"/>
            </DockPanel>
        </Border>

        <TabControl>
            <!-- ===== Tab 1: Files + filters + actions ===== -->
            <TabItem Header="Dateien &amp; Bereinigung">
                <DockPanel Margin="6">

                    <!-- Filter row -->
                    <Border DockPanel.Dock="Top" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                            Padding="8" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBlock Text="Älter als (Tage):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Width="70" Text="{Binding OlderThanDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                            <TextBlock Text="Grösser als:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Width="90" Text="{Binding LargerThan, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"
                                     ToolTip="z.B. 500 MB, 2 GB, 1048576"/>
                            <TextBlock Text="Endung:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Width="110" Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"
                                     ToolTip="z.B. .tmp, .log, .iso (mehrere mit Komma)"/>
                            <TextBlock Text="Name enthält:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Width="120" Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                            <Button Content="Filtern" Command="{Binding ApplyFilterCommand}"/>
                            <Button Content="Zurücksetzen" Command="{Binding ResetFilterCommand}"/>
                            <Separator Width="10" Background="Transparent"/>
                            <Button Content="Schnell: alt (1 J.)" Command="{Binding QuickOldCommand}"/>
                            <Button Content="Schnell: gross (&gt;500MB)" Command="{Binding QuickLargeCommand}"/>
                        </WrapPanel>
                    </Border>

                    <!-- Action row -->
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <WrapPanel>
                            <Button Content="Endgültig löschen"
                                    Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=FileGrid}"
                                    Foreground="#B00020" FontWeight="SemiBold"/>
                            <Button Content="In Quarantäne verschieben"
                                    Command="{Binding QuarantineCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=FileGrid}"/>
                            <Button Content="Kopieren / Backup..."
                                    Command="{Binding CopyCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=FileGrid}"/>
                            <Button Content="Als CSV exportieren" Command="{Binding ExportFilesCommand}"/>
                            <TextBlock Text="Tipp: mehrere Zeilen mit Strg/Shift markieren."
                                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888"/>
                        </WrapPanel>
                    </Border>

                    <!-- File grid -->
                    <DataGrid x:Name="FileGrid"
                              ItemsSource="{Binding Files}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="Grösse" Binding="{Binding SizeText}" Width="90"/>
                            <DataGridTextColumn Header="Geändert" Binding="{Binding LastModified, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                            <DataGridTextColumn Header="Alter (Tage)" Binding="{Binding AgeDays}" Width="80"/>
                            <DataGridTextColumn Header="Typ" Binding="{Binding Extension}" Width="70"/>
                            <DataGridTextColumn Header="Pfad" Binding="{Binding FullPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Tab 2: TreeSize ===== -->
            <TabItem Header="Ordnergrösse (TreeSize)">
                <TreeView ItemsSource="{Binding TreeRoots}" Margin="6">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SizeText}" Foreground="#2E7D32" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding PercentText}" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding FileCount, StringFormat=' ({0} Dateien)'}" Foreground="#AAA" Margin="6,0,0,0"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </TabItem>

            <!-- ===== Tab 3: Duplicates ===== -->
            <TabItem Header="Duplikate">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Duplikate suchen" Command="{Binding FindDuplicatesCommand}"/>
                        <Button Content="Als CSV exportieren" Command="{Binding ExportDuplicatesCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Duplicates}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Grösse je Datei" Binding="{Binding SizeText}" Width="120"/>
                            <DataGridTextColumn Header="Anzahl" Binding="{Binding Files.Count}" Width="70"/>
                            <DataGridTextColumn Header="Freigebbar" Binding="{Binding ReclaimableText}" Width="110"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Files}" Margin="24,4,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FullPath}" Foreground="#555"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
