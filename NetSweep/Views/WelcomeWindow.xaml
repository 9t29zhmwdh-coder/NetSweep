<Window x:Class="NetSweep.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetSweep - Willkommen"
        Height="540" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="NetSweep" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Network Storage Cleanup" FontSize="14" Foreground="#666" Margin="0,0,0,12"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Kurz &amp; wichtig zur Sicherheit"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        Dieses Werkzeug verbindet sich mit Netzlaufwerken (NAS / UNC-Pfaden) und kann
                        Dateien auflisten, kopieren, verschieben und <Bold>endgültig löschen</Bold>.
                        Gehe daher bewusst damit um.
                    </TextBlock>

                    <TextBlock Style="{StaticResource Heading}" Text="Empfohlenes Vorgehen"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                        • Lege auf dem NAS ein <Bold>eigenes, eingeschränktes Konto</Bold> an,
                        das nur Schreibrechte auf die Ordner hat, die wirklich bereinigt werden dürfen.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                        • Hinterlege Benutzername und Passwort pro Verbindung. Das Passwort wird
                        <Bold>verschlüsselt</Bold> und nur für dein Windows-Konto auf diesem PC gespeichert.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                        • Starte immer mit dem <Bold>Bericht/Filter</Bold>, bevor du löschst.
                        Nutze im Zweifel „In Quarantäne verschieben“ statt endgültig zu löschen.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        • Löschen erfolgt <Bold>ohne Papierkorb</Bold> und wird zweifach abgefragt.
                    </TextBlock>

                    <TextBlock Style="{StaticResource Heading}" Text="Was du tun kannst"/>
                    <TextBlock TextWrapping="Wrap">
                        Speicherbelegung pro Ordner ansehen (TreeSize-Art), alte und grosse Dateien finden,
                        Duplikate erkennen, leere Ordner entfernen, kopieren/sichern und Berichte als CSV exportieren.
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <CheckBox x:Name="DontShowAgain" Content="Diesen Hinweis kenne ich" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Schliessen" Click="Close_Click" MinWidth="110"/>
            <Button Content="Starten" Click="Start_Click" MinWidth="110" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
