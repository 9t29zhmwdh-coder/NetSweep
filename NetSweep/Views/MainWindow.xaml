<Window x:Class="NetSweep.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetSweep.ViewModels"
        xmlns:loc="clr-namespace:NetSweep.Helpers"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=MainTitle}"
        Height="520" Width="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel Margin="12">
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=ConnectionsHeading}"
                       Style="{StaticResource Heading}" VerticalAlignment="Center"/>
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=LanguageToggleLabel}"
                    ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=LanguageToggleTooltip}"
                    Click="LanguageToggle_Click" HorizontalAlignment="Right" Width="36"
                    Margin="16,0,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=Add}" Command="{Binding AddCommand}"/>
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=Edit}" Command="{Binding EditCommand}"/>
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=Remove}" Command="{Binding RemoveCommand}"/>
            <Separator Width="12" Background="Transparent"/>
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=Connect}" Command="{Binding ConnectCommand}"/>
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=OpenAnalyze}" Command="{Binding OpenCommand}" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="8,6" Margin="0,10,0,0" CornerRadius="4">
            <TextBlock Text="{Binding Status}" Foreground="#444"/>
        </Border>

        <!-- Connection list -->
        <DataGrid ItemsSource="{Binding Connections}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=ColumnName}" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=ColumnPath}" Binding="{Binding Path}" Width="*"/>
                <DataGridTextColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=ColumnUser}" Binding="{Binding Username}" Width="140"/>
                <DataGridTemplateColumn Header="{Binding Source={x:Static loc:Loc.Instance}, Path=ColumnStatus}" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IsConnected, Converter={x:Static vm:BoolToStatusConverter.Instance}}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding IsConnected, Converter={x:Static vm:BoolToBrushConverter.Instance}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
